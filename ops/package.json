{
  "name": "@lh2/platform-ops",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "bin": {
    "lh2-ops": "dist/src/cli/main.js",
    "lh2-owner-mcp": "dist/src/mcp/main.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod 755 dist/src/cli/main.js dist/src/mcp/main.js",
    "test": "npm run build && node --no-warnings --test dist/test/*.test.js",
    "ops": "npm run build --silent && node --no-warnings dist/src/cli/main.js",
    "worker:types": "wrangler types",
    "worker:types:check": "wrangler types --check",
    "worker:typecheck": "tsc -p tsconfig.worker.json",
    "worker:test": "vitest run --config vitest.worker.config.ts",
    "worker:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/supabase-js": "^2.111.0",
    "@vercel/sdk": "^1.28.12",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-auth": "^1.6.26",
    "isomorphic-git": "^1.40.0",
    "nodemailer": "^9.0.3",
    "supabase-management-js": "^2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^25.0.0",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
