{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lh2-s26-control-plane",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "minify": true,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql", "**/*.json"],
      "fallthrough": true
    }
  ],
  "vars": {
    "NEON_API_BASE_URL": "https://console.neon.tech/api/v2",
    "NEON_ORGANIZATION_ID": "org-damp-hill-86577285",
    "NEON_DATABASE_NAME": "neondb",
    "NEON_OWNER_ROLE_NAME": "neondb_owner",
    "NEON_APPLICATION_ROLE_NAME": "app_runtime",
    "NEON_AI_ROLE_NAME": "app_system",
    "NEON_MACHINE_ROLE_NAME": "app_machine",
    "NEON_IDENTITY_STORE_ROLE_NAME": "identity_store",
    "S26_APPLICATION_HOSTING_CONTRACT": "hosting.environment.v3",
    "S26_APPLICATION_DATA_PLANE_READY": "true",
    "NEON_REGION_ID": "aws-eu-central-1",
    "NEON_TIER_ID": "neon-free",
    "NEON_COMPUTE_ID": "autoscale-0.25-2cu",
    "NEON_BACKUP_PROFILE_ID": "neon-free-restore-6h",
    "VERCEL_API_BASE_URL": "https://api.vercel.com",
    "VERCEL_TEAM_ID": "team_AB0nAOId1mR7gHxPldsG9f2u",
    "VERCEL_BUILD_RECIPE_ID": "spa-plus-http-handlers-v1",
    "RESEND_API_BASE_URL": "https://api.resend.com",
    "RESEND_SMTP_PROFILE_ID": "resend-eu-west-1",
    "RESEND_SENDER_DOMAIN": "mail.ciphercross.dev",
    "RESEND_FROM_EMAIL": "noreply@mail.ciphercross.dev",
    "RESEND_FROM_IDENTITY": "CipherCross <noreply@mail.ciphercross.dev>",
    "RESEND_SMOKE_RECIPIENT": "accounts@ciphercross.com",
    "BETTER_AUTH_TEMPLATE_SET_ID": "s26-self-hosted-better-auth-v1",
    "RELEASE_COMPATIBILITY_ID": "s26-neon-hosting-v1",
    "APPROVED_APPLICATION_VERSION": "s26-c4c1957",
    "APPROVED_SCHEDULE_MANIFEST_DIGEST": "sha256:688baed28906755e59c836917b63626a44d00b2c544a7a82fe98b2cafe492ebc",
    "SOURCE_REPOSITORY_API_BASE_URL": "https://api.github.com",
    "SOURCE_REPOSITORY_OWNER": "CipherCross",
    "SOURCE_REPOSITORY_NAME": "cipher-linkedin-dashboard",
    "APPROVED_SOURCE_GIT_SHA": "c4c1957452bd647ce6377211a61558704c7d0ce8",
    "RECOVERY_OBJECT_PREFIX": "s26-control-plane/recovery/v1"
  },
  "secrets": {
    "required": [
      "BRIDGE_BEARER_SECRET",
      "NEON_API_TOKEN",
      "VERCEL_API_TOKEN",
      "RESEND_API_KEY",
      "SOURCE_REPOSITORY_TOKEN"
    ]
  },
  "r2_buckets": [
    {
      "binding": "CONTROL_PLANE_OBJECTS",
      "bucket_name": "linkedin-campaign-dashboard"
    },
    {
      "binding": "TENANT_LEAD_PHOTOS",
      "bucket_name": "lead-photos"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
