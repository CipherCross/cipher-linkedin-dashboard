{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "worker-configuration.d.ts",
    "src/worker/**/*.ts",
    "src/bridge/s26-control-plane-service.ts",
    "src/providers/s26-bridge-contract.ts",
    "src/providers/adapters.ts",
    "src/providers/hosting.ts",
    "src/core/canonical.ts",
    "src/core/errors.ts",
    "src/core/redaction.ts"
  ]
}
