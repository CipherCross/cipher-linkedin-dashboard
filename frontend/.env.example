# Copy to .env — these are safe to expose to the browser (anon key + RLS).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only (Vercel functions: /api/chat, /api/mcp, /api/classify, /api/config, /api/import).
# Set these in the Vercel project settings — NEVER expose them to the browser (no VITE_).
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Public project key used server-side only to verify user JWTs. It is safe to
# expose, but the unprefixed name makes the server trust boundary explicit.
SUPABASE_ANON_KEY=YOUR-ANON-KEY
# SUPABASE_URL is optional; server functions fall back to VITE_SUPABASE_URL.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# REQUIRED machine credentials. All three routes fail closed when unset.
# Vercel automatically sends CRON_SECRET to scheduled invocations.
CRON_SECRET=generate-a-long-random-secret
# Must match local `notify_secret` on every sync-agent notebook.
NOTIFY_SECRET=generate-a-different-long-random-secret
# Shared only with trusted MCP clients; protects read and write tools.
MCP_SECRET=generate-another-long-random-secret

# Apollo CSV Contact and Company importers. Restrict the Airtable PAT to the target base with
# schema.bases:read, data.records:read, and data.records:write. Never add VITE_.
AIRTABLE_TOKEN=pat_...
AIRTABLE_BASE_ID=app4P6PbWSwEEmOIz
