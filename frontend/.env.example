# Copy to .env. Placeholders only; set real values in the Vercel project settings.
# Each path turns on when its credential is present.

# Browser (safe to expose). The tenant contract binds VITE_AUTH_PATH=identity;
# the app no longer reads it, but the deployment still sets it.
VITE_AUTH_PATH=identity

# Server-only (Vercel functions) — NEVER expose them to the browser (no VITE_).
ANTHROPIC_API_KEY=sk-ant-...

# Neon (Postgres + RLS): the application, AI and machine (sync-agent) roles.
NEON_DATABASE_URL=
NEON_DATABASE_URL_UNPOOLED=
NEON_AI_DATABASE_URL=
NEON_MACHINE_DATABASE_URL=

# Self-hosted identity store (Better Auth, /api/identity, HttpOnly session cookie).
IDENTITY_STORE_DATABASE_URL=
IDENTITY_SESSION_SECRET=
IDENTITY_BASE_URL=
# Optional: deliver invite and password-reset links.
RESEND_API_KEY=
RESEND_FROM_IDENTITY=

# Lead photos (Cloudflare R2 / S3-compatible object storage). Optional;
# NEON_PHOTOS_DEFAULT=disabled serves initials only.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_TENANT_ID=
NEON_PHOTOS_DEFAULT=

# The tenant this deployment serves. Must equal OBJECT_STORAGE_TENANT_ID when
# both are set; without either, agent ingest answers 503.
APP_TENANT_ID=

# Signed agent release channel: the READ-scoped pair only. The write pair and
# the signing key stay with the operator (see docs/platform-ops/agent-release-channel.md).
AGENT_RELEASE_ENDPOINT=
AGENT_RELEASE_BUCKET=
AGENT_RELEASE_REGION=
AGENT_RELEASE_ACCESS_KEY_ID=
AGENT_RELEASE_SECRET_ACCESS_KEY=

# REQUIRED machine credentials. All three routes fail closed when unset.
# Vercel automatically sends CRON_SECRET to scheduled invocations.
CRON_SECRET=generate-a-long-random-secret
# Compatibility-only: current sync agents authenticate the notify ping with
# their per-notebook ingest_token.
NOTIFY_SECRET=generate-a-different-long-random-secret
# Shared only with trusted MCP clients; protects read and write tools.
MCP_SECRET=generate-another-long-random-secret

# Apollo CSV Contact and Company importers. Restrict the Airtable PAT to the target base with
# schema.bases:read, data.records:read, and data.records:write. Never add VITE_.
AIRTABLE_TOKEN=pat_...
AIRTABLE_BASE_ID=app4P6PbWSwEEmOIz

# Slack (briefings and reply alerts). SLACK_REPLIES_WEBHOOK_URL falls back to
# SLACK_WEBHOOK_URL; DASHBOARD_URL builds deep links in alerts.
SLACK_WEBHOOK_URL=
SLACK_REPLIES_WEBHOOK_URL=
DASHBOARD_URL=
